{
  inputs,
  osConfig,
  pkgs,
  lib,
  my,
  myInventory,
  ...
}:
let
  keys = import ../../modules/nixos/keys.nix;
  personasLib = import ../../lib/personas.nix { inherit lib; };
in
{
  imports = [
    ../../modules/home-manager/default.nix
    ../../modules/home-manager/gnome.nix
    inputs.nix-devshells.homeManagerModules.desktopLaunchers
  ];

  modules = {
    devshell-launchers = {
      enable = true;
      flakePath = "/home/martin/Develop/github.com/kleinbem/nix-devshells";
    };
    # Off: PWAs installed through Chrome replace these browser shortcuts.
    service-launchers.enable = false;
    mcp = {
      enable = true;
      # GIMP 3 + gimp3-mcp; start the plugin in GIMP via Tools > MCP > Start MCP Server
      gimp.enable = true;
      # Buzz developer MCP server for workspace AI coding agents
      buzz.enable = true;
      # Several Claude tabs build at once on this workstation; agents that use
      # run_task queue their builds and tests instead.
      agentTaskQueue.enable = true;
      # Home Assistant (hass-pi) via its in-process HA-MCP server; the
      # connect URL comes from the ha_mcp_url sops secret on this host.
      homeAssistant.enable = true;
    };

    opencode.enable = true;
    herdr.enable = true;
    ai-agents = {
      enable = true;
      claude.settings = lib.importJSON ./files/claude-settings.json;
      # goose (Block's agent) next to Claude Code, driving Claude Code through
      # its ACP adapter: same subscription, no API key, goose's extensions
      # reach Claude as MCP servers. "current" is goose's sentinel for the
      # agent's own model; without a model goose refuses to start a session.
      installAgents = [ "goose" ];
      goose = {
        extraPackages = [ pkgs.claude-agent-acp ];
        settings = {
          active_provider = "claude-acp";
          providers = {
            claude-acp = {
              enabled = true;
              configured = true;
              model = "current";
            };
            # The fleet mesh (my.services.meshLlm, hosts/nixos-nvme/ai.nix):
            # OpenAI-compatible on this host, no key (goose sends no auth header
            # without one). `goose session --provider openai` or
            # GOOSE_PROVIDER=openai picks it for a session.
            openai = {
              enabled = true;
              configured = true;
              model = "Qwen3-Coder-30B-A3B-Instruct-Q4_K_M";
            };
          };
          OPENAI_HOST = "http://127.0.0.1:9337";
        };
      };
    };
    gnome.enable = true;
    syncthing.enable = false; # Migrated to system container fleet
    android.enable = true; # User tools (apkeep, matepad CLI) for MatePad Pro
  };

  # User Details
  home = {
    inherit (my) username;
    homeDirectory = my.home;
    stateVersion = "25.11";
    sessionPath = [
      "${my.home}/.local/bin"
    ];
    sessionVariables = {
      DEFAULT_BROWSER = "${pkgs.google-chrome}/bin/google-chrome-stable";
      BROWSER = "${pkgs.google-chrome}/bin/google-chrome-stable";
      CHROME_BIN = "${pkgs.google-chrome}/bin/google-chrome-stable";
      CHROME_PATH = "${pkgs.google-chrome}/bin/google-chrome-stable";
      # mkForce: the neovim wrapper module also sets EDITOR (nvim); nano wins
      # so sops/git/etc. open a friendlier editor.
      EDITOR = lib.mkForce "nano";
      # Relay for the buzz CLI, buzz-acp and buzz-agent. Set here, not in
      # NixOS environment.variables, which new terminals only see after relogin.
      BUZZ_RELAY_URL = "wss://${myInventory.network.nodes.buzz.domain}";
    };

    packages = [
      (pkgs.writeShellScriptBin "chrome" ''
        exec ${pkgs.google-chrome}/bin/google-chrome-stable "$@"
      '')
    ];

    # Personal System Control Center — `os <ns>::<recipe>`. The `os`
    # shell alias lives in nix-presets/terminal.nix (generic); these
    # source files are martin-specific (Obsidian paths, etc.) and so
    # belong in martin's user dir rather than a shared preset.
    file = {
      ".justfile" = {
        source = ./files/justfile;
        force = true;
      };
      ".just" = {
        source = ./files/.just;
        recursive = true;
      };

      # ~/.ssh/allowed_signers for git (nix-presets/vcs.nix). Principal `*`
      # so Martin's keys verify under any commit email; persona keys come
      # from keys.ssh.personas.
      ".ssh/allowed_signers" = {
        force = true;
        text = ''
          # Auto-generated by home-manager.
          # Source: nix-config/modules/nixos/keys.nix (ssh.fido2*)
          #         nix-config/personas.nix + nix-config/modules/nixos/keys.nix:ssh.personas
          # DO NOT EDIT — rebuild home-manager to regenerate.

          * ${keys.ssh.fido2}
          * ${keys.ssh.fido2-backup}
          * ${keys.ssh.fido2-notouch}

          ${personasLib.allowedSigners keys.ssh.personas}'';
      };

      # Obsidian Excalidraw Plugin
      "Documents/Notes/.obsidian/plugins/obsidian-excalidraw-plugin/main.js".source = pkgs.fetchurl {
        url = "https://github.com/zsviczian/obsidian-excalidraw-plugin/releases/download/2.29.0/main.js";
        sha256 = "05qwrig5m22bjbg4zj648q1rkyxr0hh799ag90ld7rxg9r50i8jd";
      };
      "Documents/Notes/.obsidian/plugins/obsidian-excalidraw-plugin/manifest.json".source =
        pkgs.fetchurl
          {
            url = "https://github.com/zsviczian/obsidian-excalidraw-plugin/releases/download/2.29.0/manifest.json";
            sha256 = "1h1ikpvpbs3i9lrywfim8xkyk8kcfwlsikiiin2fyhq6qn2vi028";
          };
      "Documents/Notes/.obsidian/plugins/obsidian-excalidraw-plugin/styles.css".source = pkgs.fetchurl {
        url = "https://github.com/zsviczian/obsidian-excalidraw-plugin/releases/download/2.29.0/styles.css";
        sha256 = "1vbx269nl3kbnihnjiwfcp87ycjdvqiy0i1k2wy3pi8138b9qghp";
      };
    };
  };

  xdg = {
    mimeApps = {
      enable = true;
      # mkForce: nix-presets/desktop.nix sets these same keys to the stock
      # google-chrome.desktop — force wins the merge so martin gets the custom
      # google-chrome-stable.desktop entry (with the StartupWMClass fix, see
      # xdg.desktopEntries below) instead.
      defaultApplications = lib.mkForce {
        "text/html" = [ "google-chrome-stable.desktop" ];
        "x-scheme-handler/http" = [ "google-chrome-stable.desktop" ];
        "x-scheme-handler/https" = [ "google-chrome-stable.desktop" ];
        "x-scheme-handler/about" = [ "google-chrome-stable.desktop" ];
        "x-scheme-handler/unknown" = [ "google-chrome-stable.desktop" ];
      };
    };

    # HM defaults match the standard dirs plus ~/Projects.
    userDirs = {
      enable = true;
      # New HM default; set explicitly to silence the eval warning.
      setSessionVariables = false;
    };

    # Linked from the package, so it can't go stale like the entry
    # netbird-ui wrote itself (pinned to a store path that got collected).
    autostart = lib.mkIf osConfig.services.netbird.ui.enable {
      enable = true;
      entries = [ "${osConfig.services.netbird.ui.package}/share/applications/netbird.desktop" ];
    };

    # Native messaging host for the Open in App extension
    # (kleinbem/chrome-open-in-app). force: replaces the copies its
    # install.sh wrote, which pointed at a hand-built ~/.local/bin binary.
    configFile =
      lib.genAttrs
        (map (browser: "${browser}/NativeMessagingHosts/com.kleinbem.open_in_app.json") [
          "google-chrome"
          "chromium"
        ])
        (_: {
          source = "${pkgs.chrome-open-in-app-host}/etc/chromium/native-messaging-hosts/com.kleinbem.open_in_app.json";
          force = true;
        });
  };

  programs = {
    home-manager.enable = true;

    gh-dash = {
      enable = true;
      settings = {
        prSections = [
          {
            title = "My PRs";
            filters = "is:open author:@me org:kleinbem";
          }
          {
            title = "Dependabot";
            filters = "is:open org:kleinbem author:app/dependabot";
          }
          {
            title = "Fleet PRs";
            filters = "is:open org:kleinbem -author:@me -author:app/dependabot";
          }
        ];
        issuesSections = [
          {
            title = "My Issues";
            filters = "is:open assignee:@me org:kleinbem";
          }
          {
            title = "Fleet Issues";
            filters = "is:open org:kleinbem -assignee:@me";
          }
        ];
        repoPaths."kleinbem/*" = "~/Develop/github.com/kleinbem/*";
        defaults = {
          view = "prs";
          refetchIntervalMinutes = 30;
          prsLimit = 30;
          issuesLimit = 30;
        };
      };
    };

    # Inject hardware-protected signing keys from centralized proxy
    git.settings.user.signingKey = "${my.home}/.ssh/id_ed25519_sk_rk_GitHubNoTouchV2.pub";
    # jj's ssh backend wants a public-key file path; the `key::<blob>` form
    # is git-specific and silently breaks signing in jj.
    jujutsu.settings.signing.key = "${my.home}/.ssh/id_ed25519_sk_rk_GitHubNoTouchV2.pub";

    # Global gitignore, applied across every repo on this machine.
    # .ignore/ is a scratch folder convention for untracked local files.
    git.ignores = [
      "**/.claude/settings.local.json"
      ".ignore/"
    ];

    # Multiplexing: one YubiKey touch opens a master connection that later
    # ops reuse. If stale sockets cause "Session open refused by peer", run:
    #   ssh -O exit git@github.com 2>/dev/null; rm -f ~/.ssh/cm-*
    ssh = {
      enable = true;
      settings = {
        "github.com" = {
          Hostname = "github.com";
          User = "git";
          ControlMaster = "auto";
          ControlPath = "~/.ssh/cm-%r@%h:%p";
          ControlPersist = "10m";
        };

        # Fleet hosts: log in as martin with the FIDO2 key. IdentityAgent none
        # because ssh-agent can't prompt for its PIN ("agent refused
        # operation"); ControlMaster keeps it to one PIN+touch per hour.
        "hass-pi" = {
          Hostname = "10.0.0.21";
          User = "martin";
          IdentityFile = "~/.ssh/id_ed25519_sk";
          IdentityAgent = "none";
          ControlMaster = "auto";
          ControlPath = "~/.ssh/cm-%r@%h:%p";
          ControlPersist = "1h";
        };
        # initrd LUKS-unlock stage: root on port 2222 (clevis/tang usually unlocks
        # automatically; this is the manual fallback).
        "hass-pi-initrd" = {
          Hostname = "10.0.0.21";
          Port = 2222;
          User = "root";
          IdentityFile = "~/.ssh/id_ed25519_sk";
          IdentityAgent = "none";
        };
        "core-pi" = {
          Hostname = "10.0.0.22";
          User = "martin";
          IdentityFile = "~/.ssh/id_ed25519_sk";
          IdentityAgent = "none";
          ControlMaster = "auto";
          ControlPath = "~/.ssh/cm-%r@%h:%p";
          ControlPersist = "1h";
        };
        # initrd LUKS-unlock stage for core-pi
        "core-pi-initrd" = {
          Hostname = "10.0.0.22";
          Port = 2222;
          User = "root";
          IdentityFile = "~/.ssh/id_ed25519_sk";
          IdentityAgent = "none";
        };
        "mac-mini 10.0.0.16" = {
          Hostname = "10.0.0.16";
          User = "martin";
          IdentityFile = "~/.ssh/id_ed25519_sk";
          IdentityAgent = "none";
          ControlMaster = "auto";
          ControlPath = "~/.ssh/cm-%r@%h:%p";
          ControlPersist = "1h";
        };
        # Match the IP too, so `ssh 10.0.0.15` gets the same settings.
        "orin-nano 10.0.0.15" = {
          Hostname = "10.0.0.15";
          User = "martin";
          IdentityFile = "~/.ssh/id_ed25519_sk";
          IdentityAgent = "none";
          ControlMaster = "auto";
          ControlPath = "~/.ssh/cm-%r@%h:%p";
          ControlPersist = "1h";
        };
        # initrd LUKS-unlock stage for orin-nano (manual fallback; Tang auto-unlocks)
        "orin-nano-initrd" = {
          Hostname = "10.0.0.15";
          Port = 2222;
          User = "root";
          IdentityFile = "~/.ssh/id_ed25519_sk";
          IdentityAgent = "none";
        };
        # IP too: colmena's targetHost is the raw IP, not the alias.
        "nasbook 10.0.0.30" = {
          Hostname = "10.0.0.30";
          User = "martin";
          IdentityFile = "~/.ssh/id_ed25519_sk";
          IdentityAgent = "none";
          ControlMaster = "auto";
          ControlPath = "~/.ssh/cm-%r@%h:%p";
          ControlPersist = "1h";
        };
        # No-touch alias for automated tooling, so plain "nasbook" still needs
        # a touch. The key is still hardware-backed (keys.ssh.fido2-notouch).
        "nasbook-auto" = {
          Hostname = "10.0.0.30";
          User = "martin";
          IdentityFile = "~/.ssh/id_ed25519_sk_rk_GitHubNoTouchV2";
          IdentityAgent = "none";
          ControlMaster = "auto";
          ControlPath = "~/.ssh/cm-%r@%h:%p";
          ControlPersist = "1h";
        };
        # nasbook has no FIDO2 unlock (see hosts/nasbook/disko.nix) — its
        # initrd SSH fallback is unlock over the recovery passphrase only.
        "nasbook-initrd" = {
          Hostname = "10.0.0.30";
          Port = 2222;
          User = "root";
          IdentityFile = "~/.ssh/id_ed25519_sk";
          IdentityAgent = "none";
        };
      };
    };
  };

  # Desktop Launchers
  xdg.desktopEntries = {
    "launch-nested-dhirujaan" = {
      name = "Nested Session (Dhirujaan)";
      genericName = "Lightweight Wayland Session";
      exec = "sudo /home/martin/Develop/github.com/kleinbem/nix-config/scripts/launch-nested.sh";
      icon = "system-users";
      terminal = true;
      categories = [ "System" ];
    };

    # Chrome's Wayland app_id is "google-chrome-stable" but upstream's desktop
    # file is "google-chrome.desktop" with no StartupWMClass, so GNOME can't
    # match windows (PWAs included). This filename matches the app_id;
    # StartupWMClass covers XWayland.
    # no-link: Google's own package, no public report found.
    "google-chrome-stable" = {
      name = "Google Chrome";
      genericName = "Web Browser";
      exec = "google-chrome-stable %U";
      icon = "google-chrome";
      terminal = false;
      categories = [
        "Network"
        "WebBrowser"
      ];
      mimeType = [
        "text/html"
        "application/xhtml+xml"
        "x-scheme-handler/http"
        "x-scheme-handler/https"
      ];
      settings = {
        StartupNotify = "true";
        StartupWMClass = "google-chrome-stable";
      };
    };

    # Hide upstream google-chrome.desktop to prevent duplicate launcher entry
    # (shadows nixpkgs google-chrome.desktop in favor of google-chrome-stable above)
    "google-chrome" = {
      name = "Google Chrome";
      exec = "google-chrome-stable %U";
      settings = {
        NoDisplay = "true";
      };
    };
  };

  # Silencing evaluation warnings from newer Home Manager
  # (Using null adopts the new default behavior)
  gtk.gtk4.theme = null;
}
